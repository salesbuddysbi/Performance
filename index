<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Business Performance Dashboard</title>
    <!-- Tailwind CSS for Styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- SheetJS for parsing Excel -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <!-- Chart.js for Graphs -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f3f4f6; }
        .hidden { display: none !important; }
        .tab-active { border-bottom: 2px solid #2563eb; color: #2563eb; font-weight: 600; }
    </style>
</head>
<body class="text-gray-800 h-screen flex flex-col overflow-hidden">

    <!-- Upload Overlay (Shows if data.xlsx is missing) -->
    <div id="upload-overlay" class="fixed inset-0 bg-gray-900 bg-opacity-75 flex items-center justify-center z-50 hidden">
        <div class="bg-white p-8 rounded-lg shadow-xl text-center max-w-md w-full">
            <svg class="mx-auto h-12 w-12 text-blue-500 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path></svg>
            <h2 class="text-2xl font-bold mb-2">Upload Master Data</h2>
            <p class="text-gray-500 mb-6 text-sm">No default 'data.xlsx' found in repository. Please upload your master Excel file to continue.</p>
            <input type="file" id="file-upload" accept=".xlsx, .xls" class="hidden">
            <button onclick="document.getElementById('file-upload').click()" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-6 rounded transition">Browse File</button>
        </div>
    </div>

    <!-- Main App -->
    <div id="app-container" class="hidden flex-1 flex flex-col h-full">
        <!-- Header -->
        <header class="bg-white shadow-sm z-10">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex justify-between items-center py-4">
                    <h1 class="text-xl font-bold text-gray-900">Performance Portal</h1>
                    <div class="flex space-x-8">
                        <button id="tab-fresh" class="pb-1 tab-active" onclick="switchMainModule('fresh')">Fresh Business</button>
                        <button id="tab-renewal" class="pb-1 text-gray-500 hover:text-gray-700" onclick="switchMainModule('renewal')">Renewal Performance</button>
                    </div>
                </div>
            </div>
        </header>

        <!-- Filters & Sub-modules -->
        <div class="bg-gray-50 border-b">
            <div class="max-w-7xl mx-auto px-4 py-3 sm:px-6 lg:px-8 flex items-center justify-between">
                <div class="flex space-x-2 bg-gray-200 rounded-lg p-1">
                    <button id="sub-agent" class="px-4 py-1 rounded shadow bg-white text-sm font-medium" onclick="switchSubModule('agent')">Agent</button>
                    <button id="sub-manager" class="px-4 py-1 rounded text-gray-600 text-sm font-medium hover:bg-gray-300 transition" onclick="switchSubModule('manager')">Manager</button>
                    <button id="sub-cluster" class="px-4 py-1 rounded text-gray-600 text-sm font-medium hover:bg-gray-300 transition" onclick="switchSubModule('cluster')">Cluster</button>
                </div>
                
                <div class="flex space-x-4">
                    <select id="year-select" class="block w-40 pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm rounded-md shadow-sm" onchange="renderDashboard()">
                        <option value="">Select Year...</option>
                    </select>
                    
                    <select id="name-select" class="block w-64 pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm rounded-md shadow-sm" onchange="renderDashboard()">
                        <option value="">Select Name...</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Dashboard Content -->
        <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 bg-gray-100">
            <div class="max-w-7xl mx-auto space-y-6">
                
                <!-- Financial Year Calendar Grid -->
                <h2 class="text-lg font-semibold text-gray-700" id="grid-title">Financial Year Calendar</h2>
                <div id="fy-grid" class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4">
                    <!-- Cards generated via JS -->
                </div>

                <!-- Graphical Representation -->
                <div class="bg-white p-4 rounded-lg shadow-sm border border-gray-200">
                    <h2 class="text-lg font-semibold text-gray-700 mb-4">Performance Trend (FY)</h2>
                    <div class="relative h-72 w-full">
                        <canvas id="performanceChart"></canvas>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        // === CONFIGURATION ===
        // Change these strings if your Excel column headers differ
        const COL_AGENT = "Agent Name";
        const COL_MANAGER = "Manager Name";
        const COL_DATE = "Policy Start Date";
        const COL_TYPE = "Policy Type";
        const COL_PREM = "Premium";
        const COL_STATUS = "Renewal Status"; // "Renewed" or "Missed"

        const FY_MONTHS = ["Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec", "Jan", "Feb", "Mar"];

        // === STATE ===
        let rawData = [];
        let chartInstance = null;
        let state = {
            main: 'fresh', // 'fresh' | 'renewal'
            sub: 'agent'   // 'agent' | 'manager' | 'cluster'
        };

        // === INITIALIZATION ===
        document.addEventListener("DOMContentLoaded", () => {
            attemptFetchDefaultFile();
            
            document.getElementById('file-upload').addEventListener('change', (e) => {
                const file = e.target.files[0];
                if (file) loadExcel(file);
            });
        });

        async function attemptFetchDefaultFile() {
            try {
                const response = await fetch('data.xlsx');
                if (!response.ok) throw new Error('File not found');
                const arrayBuffer = await response.arrayBuffer();
                parseExcelData(arrayBuffer);
            } catch (error) {
                console.log("Default file not found, showing upload prompt.");
                document.getElementById('upload-overlay').classList.remove('hidden');
            }
        }

        function loadExcel(file) {
            const reader = new FileReader();
            reader.onload = (e) => parseExcelData(e.target.result);
            reader.readAsArrayBuffer(file);
        }

        function parseExcelData(buffer) {
            try {
                const workbook = XLSX.read(buffer, { type: 'array', cellDates: true });
                rawData = [];
                // Process all tabs
                workbook.SheetNames.forEach(sheetName => {
                    const sheet = XLSX.utils.sheet_to_json(workbook.Sheets[sheetName]);
                    // Add year from tab if date is missing (optional fallback, currently relies on COL_DATE)
                    rawData = rawData.concat(sheet);
                });
                
                document.getElementById('upload-overlay').classList.add('hidden');
                document.getElementById('app-container').classList.remove('hidden');
                
                updateDropdowns();
            } catch (err) {
                alert("Error parsing Excel file. Ensure it's a valid .xlsx format.");
                console.error(err);
            }
        }

        // === UI INTERACTION ===
        function switchMainModule(module) {
            state.main = module;
            document.getElementById('tab-fresh').classList.toggle('tab-active', module === 'fresh');
            document.getElementById('tab-fresh').classList.toggle('text-gray-500', module !== 'fresh');
            document.getElementById('tab-renewal').classList.toggle('tab-active', module === 'renewal');
            document.getElementById('tab-renewal').classList.toggle('text-gray-500', module !== 'renewal');
            updateDropdowns();
        }

        function switchSubModule(module) {
            state.sub = module;
            ['agent', 'manager', 'cluster'].forEach(m => {
                const btn = document.getElementById(`sub-${m}`);
                if (m === module) {
                    btn.className = "px-4 py-1 rounded shadow bg-white text-sm font-medium";
                } else {
                    btn.className = "px-4 py-1 rounded text-gray-600 text-sm font-medium hover:bg-gray-300 transition";
                }
            });
            updateDropdowns();
        }

        function updateDropdowns() {
            const yearSelect = document.getElementById('year-select');
            const nameSelect = document.getElementById('name-select');
            
            // Extract unique Years
            const years = [...new Set(rawData.map(row => {
                if(!row[COL_DATE]) return null;
                const d = new Date(row[COL_DATE]);
                if (isNaN(d)) return null;
                // Calculate FY based on Month
                return d.getMonth() >= 3 ? d.getFullYear() : d.getFullYear() - 1;
            }).filter(y => y !== null))].sort((a, b) => b - a);

            yearSelect.innerHTML = '<option value="">Select Year...</option>' + years.map(y => `<option value="${y}">FY ${y}-${y+1}</option>`).join('');

            // Handle Name dropdown visibility
            if (state.sub === 'cluster') {
                nameSelect.classList.add('hidden');
            } else {
                nameSelect.classList.remove('hidden');
                const colKey = state.sub === 'agent' ? COL_AGENT : COL_MANAGER;
                const names = [...new Set(rawData.map(row => row[colKey]).filter(n => n))].sort();
                nameSelect.innerHTML = '<option value="">Select Name...</option>' + names.map(n => `<option value="${n}">${n}</option>`).join('');
            }
            
            document.getElementById('fy-grid').innerHTML = ''; // Clear grid
            if(chartInstance) chartInstance.destroy();
        }

        // === DATA PROCESSING & RENDERING ===
        function renderDashboard() {
            const selectedYear = parseInt(document.getElementById('year-select').value);
            const selectedName = document.getElementById('name-select').value;
            
            if (!selectedYear) return;
            if (state.sub !== 'cluster' && !selectedName) return;

            // Initialize Grid Data array
            const fyData = Array.from({ length: 12 }, () => ({
                freshNOP: 0, freshAmount: 0,
                renNOP: 0, renRenewed: 0, renMissed: 0
            }));

            // Filter and Aggregate Data
            rawData.forEach(row => {
                if(!row[COL_DATE]) return;
                const date = new Date(row[COL_DATE]);
                if (isNaN(date)) return;

                const month = date.getMonth(); // 0-11
                const year = date.getFullYear();
                
                // Determine FY of this row
                const rowFY = month >= 3 ? year : year - 1;
                if (rowFY !== selectedYear) return;

                // Check Name filter
                if (state.sub === 'agent' && row[COL_AGENT] !== selectedName) return;
                if (state.sub === 'manager' && row[COL_MANAGER] !== selectedName) return;

                // Map standard month to FY month (April = 0, March = 11)
                const fyMonthIndex = month >= 3 ? month - 3 : month + 9;
                
                const pType = (row[COL_TYPE] || '').toLowerCase();
                const premium = parseFloat(row[COL_PREM]) || 0;

                if (state.main === 'fresh' && pType.includes('fresh')) {
                    fyData[fyMonthIndex].freshNOP++;
                    fyData[fyMonthIndex].freshAmount += premium;
                } 
                else if (state.main === 'renewal' && pType.includes('renewal')) {
                    fyData[fyMonthIndex].renNOP++;
                    const status = (row[COL_STATUS] || '').toLowerCase();
                    if (status.includes('renewed')) fyData[fyMonthIndex].renRenewed++;
                    else if (status.includes('missed')) fyData[fyMonthIndex].renMissed++;
                }
            });

            renderGrid(fyData);
            renderChart(fyData);
        }

        function renderGrid(fyData) {
            const grid = document.getElementById('fy-grid');
            let html = '';

            fyData.forEach((data, index) => {
                const monthName = FY_MONTHS[index];
                
                if (state.main === 'fresh') {
                    html += `
                    <div class="bg-white rounded-lg shadow border border-gray-100 p-4">
                        <div class="text-sm font-bold text-gray-500 uppercase tracking-wider mb-2">${monthName}</div>
                        <div class="text-2xl font-bold text-blue-600">₹${data.freshAmount.toLocaleString('en-IN')}</div>
                        <div class="text-sm text-gray-600 mt-1"><span class="font-semibold">${data.freshNOP}</span> NOP</div>
                    </div>`;
                } else {
                    html += `
                    <div class="bg-white rounded-lg shadow border border-gray-100 p-4">
                        <div class="text-sm font-bold text-gray-500 uppercase tracking-wider mb-2">${monthName}</div>
                        <div class="text-xl font-bold text-gray-800">Total NOP: ${data.renNOP}</div>
                        <div class="flex justify-between mt-2 text-sm">
                            <span class="text-green-600 font-medium">${data.renRenewed} Renewed</span>
                            <span class="text-red-500 font-medium">${data.renMissed} Missed</span>
                        </div>
                    </div>`;
                }
            });
            
            grid.innerHTML = html;
        }

        function renderChart(fyData) {
            const ctx = document.getElementById('performanceChart').getContext('2d');
            if (chartInstance) chartInstance.destroy();

            const labels = FY_MONTHS;
            let datasets = [];

            if (state.main === 'fresh') {
                datasets = [
                    {
                        label: 'Fresh Business Amount',
                        data: fyData.map(d => d.freshAmount),
                        backgroundColor: 'rgba(59, 130, 246, 0.5)', // Blue
                        borderColor: 'rgb(59, 130, 246)',
                        borderWidth: 2,
                        type: 'bar',
                        yAxisID: 'y'
                    },
                    {
                        label: 'Fresh NOP',
                        data: fyData.map(d => d.freshNOP),
                        borderColor: 'rgb(249, 115, 22)', // Orange
                        borderWidth: 2,
                        type: 'line',
                        tension: 0.3,
                        yAxisID: 'y1'
                    }
                ];
            } else {
                datasets = [
                    {
                        label: 'Renewed',
                        data: fyData.map(d => d.renRenewed),
                        backgroundColor: 'rgba(34, 197, 94, 0.7)', // Green
                        type: 'bar'
                    },
                    {
                        label: 'Missed',
                        data: fyData.map(d => d.renMissed),
                        backgroundColor: 'rgba(239, 68, 68, 0.7)', // Red
                        type: 'bar'
                    }
                ];
            }

            chartInstance = new Chart(ctx, {
                type: 'bar',
                data: { labels, datasets },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    scales: state.main === 'fresh' ? {
                        y: { type: 'linear', display: true, position: 'left', title: { display: true, text: 'Amount' } },
                        y1: { type: 'linear', display: true, position: 'right', grid: { drawOnChartArea: false }, title: { display: true, text: 'NOP' } }
                    } : {
                        x: { stacked: true },
                        y: { stacked: true, title: { display: true, text: 'Number of Policies' } }
                    }
                }
            });
        }
    </script>
</body>
</html>
